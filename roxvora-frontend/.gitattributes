# Normalize line endings: store LF in the repo, check out per-platform.
* text=auto eol=lf

# Windows
*.bat eol=crlf
*.cmd eol=crlf

# Keep binaries from being line-ending mangled
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary